# IntelliCode Environment Variables (Optional)
# Copy this file to .env for local overrides. Never commit .env or real secrets.

# Optional: Custom GitHub OAuth App Client ID for Device Flow authentication.
# Leave unset to use the built-in public OAuth client ID or sign in via `gh` CLI / PAT.
# GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
# VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
