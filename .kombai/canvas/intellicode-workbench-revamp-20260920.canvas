        </span>\n                        </div>\n                        <div class=\"ic-code-line flex h-6 items-center whitespace-pre px-4\" data-kid=\"1-3-3-4-1-2-15\" data-name=\"code line\">\n                            <span class=\"pl-6 text-[#cbd5e1]\" data-kid=\"1-3-3-4-1-2-15-1\">\n                                files:\n                            </span>\n                            <span class=\"text-[#9cb7e4]\" data-kid=\"1-3-3-4-1-2-15-2\">\n                                ProjectFile\n                            </span>\n                            <span class=\"text-[#cbd5e1]\" data-kid=\"1-3-3-4-1-2-15-3\">\n                                [];\n                            </span>\n                        </div>\n                        <div class=\"ic-code-line flex h-6 items-center whitespace-pre px-4\" data-kid=\"1-3-3-4-1-2-16\" data-name=\"code line\">\n                            <span class=\"pl-6 text-[#cbd5e1]\" data-kid=\"1-3-3-4-1-2-16-1\">\n                                graph:\n                            </span>\n                            <span class=\"text-[#9cb7e4]\" data-kid=\"1-3-3-4-1-2-16-2\">\n                                GraphNode\n                            </span>\n                            <span class=\"text-[#cbd5e1]\" data-kid=\"1-3-3-4-1-2-16-3\">\n                                [];\n                            </span>\n                        </div>\n                        <div class=\"ic-code-line flex h-6 items-center whitespace-pre px-4\" data-kid=\"1-3-3-4-1-2-17\" data-name=\"code line\">\n                            <span class=\"text-[#cbd5e1]\" data-kid=\"1-3-3-4-1-2-17-1\">\n                                };\n                            </span>\n                        </div>\n                        <div class=\"ic-code-line flex h-6 items-center whitespace-pre px-4\" data-kid=\"1-3-3-4-1-2-18\" data-name=\"code line\">\n                        </div>\n                        <div class=\"ic-code-line flex h-6 items-center whitespace-pre px-4\" data-kid=\"1-3-3-4-1-2-19\" data-name=\"code line\">\n                            <span class=\"text-[#66768b]\" data-kid=\"1-3-3-4-1-2-19-1\">\n                                // Save context once; reuse across model handover\n                            </span>\n                        </div>\n                        <div class=\"ic-code-line flex h-6 items-center whitespace-pre px-4\" data-kid=\"1-3-3-4-1-2-20\" data-name=\"code line\">\n                            <span class=\"text-[#e58aa0]\" data-kid=\"1-3-3-4-1-2-20-1\">\n                                export default\n                            </span>\n                            <span class=\"px-2 text-[#81c9d4]\" data-kid=\"1-3-3-4-1-2-20-2\">\n                                loadWorkspace\n                            </span>\n                            <span class=\"text-[#66768b]\" data-kid=\"1-3-3-4-1-2-20-3\">\n                                ;\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"w-[86px] shrink-0 border-l border-[#202b39] bg-[#0a0f15] px-2 py-4 opacity-95\" data-kid=\"1-3-3-4-1-3\" data-purpose=\"code-minimap\">\n                        <div class=\"mb-1 h-1 w-11 bg-[#e58aa0]/60\" data-kid=\"1-3-3-4-1-3-1\">\n                        </div>\n                        <div class=\"mb-1 ml-2 h-1 w-16 bg-[#66768b]/60\" data-kid=\"1-3-3-4-1-3-2\">\n                        </div>\n                        <div class=\"mb-1 h-1 w-0 bg-transparent\" data-kid=\"1-3-3-4-1-3-3\">\n                        </div>\n                        <div class=\"mb-1 h-1 w-14 bg-[#81c9d4]/70\" data-kid=\"1-3-3-4-1-3-4\">\n                        </div>\n                        <div class=\"mb-1 ml-3 h-1 w-11 bg-[#e4ad6d]/70\" data-kid=\"1-3-3-4-1-3-5\">\n                        </div>\n                        <div class=\"mb-1 ml-3 h-1 w-15 bg-[#81c9d4]/60\" data-kid=\"1-3-3-4-1-3-6\">\n                        </div>\n                        <div class=\"mb-1 ml-3 h-1 w-14 bg-[#e58aa0]/60\" data-kid=\"1-3-3-4-1-3-7\">\n                        </div>\n                        <div class=\"mb-2 h-1 w-5 bg-[#cbd5e1]/60\" data-kid=\"1-3-3-4-1-3-8\">\n                        </div>\n                        <div class=\"h-[66px] border border-[#3b82f6] bg-[#3b82f6]/10\" data-kid=\"1-3-3-4-1-3-9\">\n                        </div>\n                        <div class=\"mt-2 mb-1 h-1 w-12 bg-[#66768b]/60\" data-kid=\"1-3-3-4-1-3-10\">\n                        </div>\n                        <div class=\"mb-1 h-1 w-16 bg-[#e58aa0]/60\" data-kid=\"1-3-3-4-1-3-11\">\n                        </div>\n                        <div class=\"mb-1 h-1 w-14 bg-[#81c9d4]/60\" data-kid=\"1-3-3-4-1-3-12\">\n                        </div>\n                        <div class=\"mb-1 ml-3 h-1 w-10 bg-[#e4ad6d]/60\" data-kid=\"1-3-3-4-1-3-13\">\n                        </div>\n                        <div class=\"mt-6 border-t border-[#202b39] pt-2 text-center text-[8px] text-[#5e6e82]\" data-kid=\"1-3-3-4-1-3-14\" data-name=\"minimap total lines count\">\n                            20L\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- BOTTOM-RIGHT COPILOT DRAWER -->\n            <aside class=\"absolute bottom-4 right-4 z-10 flex h-[268px] w-[394px] flex-col border border-[#394758] bg-[#101720]\" data-kid=\"1-3-3-5\" data-name=\"copilot drawer\" data-purpose=\"copilot-drawer\">\n                <div class=\"flex h-9 shrink-0 items-center justify-between border-b border-[#394758] bg-[#131c27] px-3\" data-kid=\"1-3-3-5-1\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-3-5-1-1\">\n                        <i class=\"ti ti-message-2 text-[16px] text-[#69c2cf]\" data-kid=\"1-3-3-5-1-1-1\">\n                        </i>\n                        <span class=\"text-[11px] font-semibold text-[#e6edf5]\" data-kid=\"1-3-3-5-1-1-2\">\n                            Copilot\n                        </span>\n                        <span class=\"ic-mono text-[9px] text-[#718196]\" data-kid=\"1-3-3-5-1-1-3\">\n                            CONTEXT INSPECTOR\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2 ic-mono text-[9px] text-[#748397]\" data-kid=\"1-3-3-5-1-2\">\n                        <span data-kid=\"1-3-3-5-1-2-1\">\n                            Claude 3.5 Sonnet\n                        </span>\n                        <button aria-label=\"Close copilot\" class=\"ic-focus text-[#8090a3] hover:text-white\" data-kid=\"1-3-3-5-1-2-2\">\n                            <i class=\"ti ti-x text-[14px]\" data-kid=\"1-3-3-5-1-2-2-1\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"ic-scroll min-h-0 flex-1 overflow-y-auto px-3 py-2\" data-kid=\"1-3-3-5-2\">\n                    <div class=\"border-l-2 border-[#69c2cf] pl-2\" data-kid=\"1-3-3-5-2-1\">\n                        <div class=\"ic-mono text-[9px] text-[#6f8094]\" data-kid=\"1-3-3-5-2-1-1\">\n                            CLAUDE · JUST NOW\n                        </div>\n                        <p class=\"mt-1 text-[10px] leading-[1.55] text-[#cbd5df]\" data-kid=\"1-3-3-5-2-1-2\" data-name=\"copilot response text\">\n                            Workspace context is synced.\n                            <span class=\"text-[#f0b46f]\" data-kid=\"1-3-3-5-2-1-2-1\" data-name=\"copilot referenced filename\">\n                                index.ts\n                            </span>\n                            reaches 3 direct callers and 5 transitive nodes.\n                        </p>\n                        <div class=\"mt-2 flex gap-3 border-t border-[#2a3545] pt-1.5 ic-mono text-[9px] text-[#7b8b9f]\" data-kid=\"1-3-3-5-2-1-3\">\n                            <span class=\"text-[#74c99b]\" data-kid=\"1-3-3-5-2-1-3-1\" data-name=\"copilot tokens saved value\">\n                                TOKENS SAVED 16.4k\n                            </span>\n                            <span data-kid=\"1-3-3-5-2-1-3-2\">\n                                HANDOVER 100%\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 border-l-2 border-[#f08aa0] pl-2\" data-kid=\"1-3-3-5-2-2\">\n                        <div class=\"ic-mono text-[9px] text-[#6f8094]\" data-kid=\"1-3-3-5-2-2-1\">\n                            YOU · 21:39\n                        </div>\n                        <p class=\"mt-1 text-[10px] text-[#cbd5df]\" data-kid=\"1-3-3-5-2-2-2\">\n                            Review the affected files before running tests.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"border-t border-[#394758] bg-[#0d141d] p-2\" data-kid=\"1-3-3-5-3\">\n                    <div class=\"mb-2 flex items-center justify-between border border-[#2f3c4d] bg-[#141d28] px-2 py-1.5\" data-kid=\"1-3-3-5-3-1\">\n                        <span class=\"ic-mono text-[9px] text-[#7a8a9e]\" data-kid=\"1-3-3-5-3-1-1\" data-name=\"recommended action label\">\n                            RECOMMENDED ACTION\n                        </span>\n                        <button class=\"ic-focus flex items-center gap-1.5 text-[10px] font-semibold text-[#74c99b] hover:text-white\" data-kid=\"1-3-3-5-3-1-2\">\n                            <i class=\"ti ti-player-play text-[12px]\" data-kid=\"1-3-3-5-3-1-2-1\">\n                            </i>\n                            Run targeted tests\n                        </button>\n                    </div>\n                    <div class=\"flex items-center gap-2 border-b border-[#405064] px-1 pb-1\" data-kid=\"1-3-3-5-3-2\">\n                        <i class=\"ti ti-prompt text-[14px] text-[#7a8a9e]\" data-kid=\"1-3-3-5-3-2-1\">\n                        </i>\n                        <span class=\"flex-1 text-[10px] text-[#6f8094]\" data-kid=\"1-3-3-5-3-2-2\">\n                            Ask with shared context...\n                        </span>\n                        <button aria-label=\"Send prompt\" class=\"ic-focus flex h-6 w-6 items-center justify-center bg-[#3b82f6] text-white\" data-kid=\"1-3-3-5-3-2-3\">\n                            <i class=\"ti ti-arrow-up text-[14px]\" data-kid=\"1-3-3-5-3-2-3-1\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </aside>\n        </main>\n    </div>\n    <!-- MACHINE STATUS LINE -->\n    <footer class=\"flex h-6 shrink-0 items-center justify-between border-t border-[#2a3545] bg-[#080b10] px-3 ic-mono text-[10px] text-[#8391a3]\" data-kid=\"1-4\" data-name=\"status line\" data-purpose=\"status-line\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-4-1\">\n            <span class=\"flex items-center gap-1.5 text-[#b4c0ce]\" data-kid=\"1-4-1-1\">\n                <i class=\"ti ti-git-branch text-[13px]\" data-kid=\"1-4-1-1-1\">\n                </i>\n                main\n            </span>\n            <span class=\"h-3 w-px bg-[#2a3545]\" data-kid=\"1-4-1-2\">\n            </span>\n            <span class=\"text-[#8c9bad]\" data-kid=\"1-4-1-3\">\n                ↻\n            </span>\n            <span class=\"text-[#8796a9]\" data-kid=\"1-4-1-4\" data-name=\"error count\">\n                0 errors\n            </span>\n            <span class=\"text-[#8796a9]\" data-kid=\"1-4-1-5\" data-name=\"warning count\">\n                0 warnings\n            </span>\n            <span class=\"h-3 w-px bg-[#2a3545]\" data-kid=\"1-4-1-6\">\n            </span>\n            <span class=\"flex items-center gap-1.5 text-[#dfaa67]\" data-kid=\"1-4-1-7\">\n                <span class=\"h-1.5 w-1.5 bg-[#f59e0b]\" data-kid=\"1-4-1-7-1\">\n                </span>\n                CIA Guard Active\n            </span>\n        </div>\n        <div class=\"flex items-center gap-3\" data-kid=\"1-4-2\">\n            <span class=\"text-[#69c2cf]\" data-kid=\"1-4-2-1\" data-name=\"MCP connection status\">\n                MCP: 5/5 Connected\n            </span>\n            <span class=\"h-3 w-px bg-[#2a3545]\" data-kid=\"1-4-2-2\">\n            </span>\n            <span data-kid=\"1-4-2-3\">\n                Cache:\n                <b class=\"font-medium text-[#74c99b]\" data-kid=\"1-4-2-3-1\" data-name=\"cache percentage\">\n                    96.8%\n                </b>\n            </span>\n            <span class=\"h-3 w-px bg-[#2a3545]\" data-kid=\"1-4-2-4\">\n            </span>\n            <span class=\"text-[#95b6e9]\" data-kid=\"1-4-2-5\">\n                TS\n            </span>\n            <span data-kid=\"1-4-2-6\" data-name=\"file encoding\">\n                UTF-8\n            </span>\n            <span data-kid=\"1-4-2-7\" data-name=\"line endings format\">\n                LF\n            </span>\n            <span data-kid=\"1-4-2-8\" data-name=\"language mode\">\n                { } TypeScript\n            </span>\n        </div>\n    </footer>\n</div>\n",
