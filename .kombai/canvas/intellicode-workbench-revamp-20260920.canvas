ection\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"impact section header\">\n                            <span class=\"text-[10px] font-semibold uppercase tracking-[0.13em] text-[#8897a9]\" data-kid=\"1-1-2-4-2-2-1-1\" data-name=\"impact title text\">\n                                Impact context\n                            </span>\n                            <span class=\"ledger-code text-[10px] text-[#65758a]\" data-kid=\"1-1-2-4-2-2-1-2\" data-name=\"target filename text\">\n                                index.ts\n                            </span>\n                        </div>\n                        <div class=\"mt-3 border-l border-[#35445b] pl-3\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"impact status message\">\n                            <div class=\"flex items-center gap-2 text-[11px] text-[#c8d1dc]\" data-kid=\"1-1-2-4-2-2-2-1\" data-name=\"status message row\">\n                                <span class=\"h-1.5 w-1.5 bg-[#f59e0b]\" data-kid=\"1-1-2-4-2-2-2-1-1\" data-name=\"indicator dot\">\n                                </span>\n                                <span data-kid=\"1-1-2-4-2-2-2-1-2\" data-name=\"status label\">\n                                    Impact unavailable\n                                </span>\n                            </div>\n                            <p class=\"mt-1 text-[11px] leading-5 text-[#6f7e91]\" data-kid=\"1-1-2-4-2-2-2-2\" data-name=\"detail text\">\n                                No modified file has been analyzed yet.\n                            </p>\n                            <button class=\"mt-3 flex h-7 items-center gap-1.5 border border-[#2b384e] px-2 text-[10px] text-[#aab7c6] hover:bg-[#151e2b] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#3b82f6]\" data-kid=\"1-1-2-4-2-2-2-3\" data-name=\"open analysis button\">\n                                <i class=\"ti ti-activity text-[12px]\" data-kid=\"1-1-2-4-2-2-2-3-1\" data-name=\"activity icon\">\n                                </i>\n                                Open impact analysis\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <form aria-label=\"Copilot message composer\" class=\"border-t border-[#202a3a] bg-[#0a0e14] p-3\" data-kid=\"1-1-2-4-3\" data-name=\"message composer form\">\n                    <label class=\"mb-1.5 block text-[10px] text-[#78879a]\" data-kid=\"1-1-2-4-3-1\" data-name=\"input label\" for=\"context-prompt\">\n                        Ask with shared context\n                    </label>\n                    <div class=\"flex items-center border border-[#2b384e] bg-[#111824] focus-within:border-[#06b6d4] focus-within:ring-1 focus-within:ring-[#06b6d4]/40\" data-kid=\"1-1-2-4-3-2\" data-name=\"input field area\">\n                        <input class=\"min-w-0 flex-1 bg-transparent px-2.5 py-2 text-[11px] text-[#e8edf3] outline-none placeholder:text-[#68778b]\" data-kid=\"1-1-2-4-3-2-1\" data-name=\"message text input\" id=\"context-prompt\" placeholder=\"Ask Claude 3.5 Sonnet…\"/>\n                        <button aria-label=\"Send message\" class=\"flex h-8 w-9 items-center justify-center text-[#06b6d4] hover:bg-[#16202d] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#3b82f6]\" data-kid=\"1-1-2-4-3-2-2\" data-name=\"send message button\">\n                            <i class=\"ti ti-arrow-up text-[15px]\" data-kid=\"1-1-2-4-3-2-2-1\" data-name=\"arrow icon\">\n                            </i>\n                        </button>\n                    </div>\n                </form>\n            </aside>\n        </div>\n        <!-- Status line -->\n        <footer aria-label=\"Status bar\" class=\"flex h-7 shrink-0 items-center justify-between border-t border-[#202a3a] bg-[#080b10] px-3 ledger-code text-[10px] text-[#8291a4]\" data-kid=\"1-1-3\" data-name=\"status bar\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-3-1\" data-name=\"status left section\">\n                <span class=\"flex items-center gap-1.5 text-[#b2bdca]\" data-kid=\"1-1-3-1-1\" data-name=\"git branch status\">\n                    <i class=\"ti ti-git-branch text-[12px]\" data-kid=\"1-1-3-1-1-1\" data-name=\"git branch icon\">\n                    </i>\n                    main\n                </span>\n                <span class=\"text-[#526176]\" data-kid=\"1-1-3-1-2\" data-name=\"sync indicator\">\n                    ↻\n                </span>\n                <span class=\"flex items-center gap-1.5\" data-kid=\"1-1-3-1-3\" data-name=\"error indicator\">\n                    <i class=\"ti ti-circle-x text-[12px] text-[#8291a4]\" data-kid=\"1-1-3-1-3-1\" data-name=\"error icon\">\n                    </i>\n                    0\n                </span>\n                <span class=\"flex items-center gap-1.5\" data-kid=\"1-1-3-1-4\" data-name=\"warning indicator\">\n                    <i class=\"ti ti-alert-triangle text-[12px] text-[#8291a4]\" data-kid=\"1-1-3-1-4-1\" data-name=\"warning icon\">\n                    </i>\n                    0\n                </span>\n                <span class=\"flex items-center gap-1.5 text-[#e1bf66]\" data-kid=\"1-1-3-1-5\" data-name=\"cia status indicator\">\n                    <span class=\"h-1.5 w-1.5 bg-[#f59e0b]\" data-kid=\"1-1-3-1-5-1\" data-name=\"indicator dot\">\n                    </span>\n                    CIA Guard Active\n                </span>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-3-2\" data-name=\"status right section\">\n                <span class=\"text-[#8fcfb5]\" data-kid=\"1-1-3-2-1\" data-name=\"mcp status text\">\n                    MCP: 5/5 Connected\n                </span>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"cache status text\">\n                    Cache:\n                    <span class=\"text-[#a9d9c2]\" data-kid=\"1-1-3-2-2-1\" data-name=\"cache percentage\">\n                        96.8%\n                    </span>\n                </span>\n                <span class=\"text-[#77a9ff]\" data-kid=\"1-1-3-2-3\" data-name=\"language mode text\">\n                    TS\n                </span>\n                <span data-kid=\"1-1-3-2-4\" data-name=\"encoding format text\">\n                    UTF-8\n                </span>\n                <span data-kid=\"1-1-3-2-5\" data-name=\"newline format text\">\n                    LF\n                </span>\n                <span data-kid=\"1-1-3-2-6\" data-name=\"typescript configuration text\">\n                    { } TypeScript\n                </span>\n            </div>\n        </footer>\n    </div>\n</div>\n",
