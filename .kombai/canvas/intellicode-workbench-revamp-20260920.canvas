etween\" data-kid=\"1-1-2-4-1-1\" data-name=\"title area\">\n                        <span class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[#aeb9c7]\" data-kid=\"1-1-2-4-1-1-1\" data-name=\"title text\">\n                            Context\n                        </span>\n                        <button aria-label=\"Close context panel\" class=\"flex h-7 w-7 items-center justify-center text-[#7d8ca0] hover:bg-[#151e2b] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#3b82f6]\" data-kid=\"1-1-2-4-1-1-2\" data-name=\"collapse button\">\n                            <i class=\"ti ti-layout-sidebar-right-collapse text-[15px]\" data-kid=\"1-1-2-4-1-1-2-1\" data-name=\"collapse icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-2 flex items-center gap-2 text-[11px] text-[#7d8ca0]\" data-kid=\"1-1-2-4-1-2\" data-name=\"current context file indicator\">\n                        <i class=\"ti ti-file-code text-[14px] text-[#66a7ff]\" data-kid=\"1-1-2-4-1-2-1\" data-name=\"code file icon\">\n                        </i>\n                        <span class=\"ledger-code text-[#cad4df]\" data-kid=\"1-1-2-4-1-2-2\" data-name=\"filename text\">\n                            src/index.ts\n                        </span>\n                    </div>\n                    <div aria-label=\"Context tabs\" class=\"mt-3 flex h-7 items-end gap-4 text-[11px]\" data-kid=\"1-1-2-4-1-3\" data-name=\"inspector mode tabs\" role=\"tablist\">\n                        <button aria-selected=\"true\" class=\"h-7 border-b-2 border-[#06b6d4] px-1 text-[#e4f4f7]\" data-kid=\"1-1-2-4-1-3-1\" data-name=\"notes tab button\" role=\"tab\">\n                            Notes\n                        </button>\n                        <button aria-selected=\"false\" class=\"h-7 px-1 text-[#718096] hover:text-[#d4dce5]\" data-kid=\"1-1-2-4-1-3-2\" data-name=\"impa