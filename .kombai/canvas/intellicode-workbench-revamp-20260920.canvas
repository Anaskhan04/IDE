      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.30.0/tabler-icons.min.css');\n  .ledger-ui { font-family: 'Inter', sans-serif; }\n  .ledger-code { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n  .ledger-ui [data-name=\"intellicode logo mark\"] { font-size: 0; }\n  .ledger-ui [data-name=\"intellicode logo mark\"]::before { content: '</>'; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; }\n  .hairline { background-image: linear-gradient(to right, transparent 0, transparent 49%, rgba(43, 56, 78, .22) 50%, transparent 51%); }\n  .code-line { min-height: 22px; }\n</style>\n<div class=\"ledger-ui min-h-[900px] w-full bg-[#080b10] text-[#c7d0dc] antialiased selection:bg-[#3b82f6]/30 selection:text-white\" data-kid=\"1\" data-name=\"ide layout container\">\n    <div class=\"flex min-h-[900px] flex-col overflow-hidden border border-[#202a3a] bg-[#0c1017]\" data-kid=\"1-1\" data-name=\"workbench container\">\n        <!-- Top command strip -->\n        <header aria-label=\"Global command strip\" class=\"flex h-12 shrink-0 items-center gap-5 border-b border-[#202a3a] bg-[#090d14] px-4\" data-kid=\"1-1-1\" data-name=\"top command strip\">\n            <div class=\"flex w-[265px] shrink-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"branding and workspace area\">\n                <div aria-label=\"IntelliCode code mark\" class=\"flex h-7 w-7 items-center justify-center border border-[#3b82f6] text-[12px] font-semibold text-[#77a9ff]\" data-kid=\"1-1-1-1-1\" data-name=\"intellicode logo mark\">\n                </div>\n                <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-1-2\" data-name=\"branding title area\">\n                    <span class=\"text-[14px] font-semibold tracking-[0.01em] text-[#f5f7fa]\" data-kid=\"1-1-1-1-2-1\" d