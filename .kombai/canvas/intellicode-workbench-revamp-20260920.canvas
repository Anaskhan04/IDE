      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/tabler-icons.min.css');\n</style>\n<div class=\"h-[900px] w-full min-w-[1180px] overflow-hidden bg-[#0c1017] text-[#d7dee8] font-sans antialiased flex flex-col select-none\" data-kid=\"1\" data-name=\"intellicode workspace layout\">\n    <header class=\"h-[48px] shrink-0 border-b border-[#21293a] bg-[#0b0f15] flex items-center\" data-kid=\"1-1\" data-name=\"header bar\">\n        <div class=\"w-[270px] shrink-0 h-full px-4 flex items-center gap-3 border-r border-[#21293a]\" data-kid=\"1-1-1\" data-name=\"logo and version area\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"logo container\">\n                <span class=\"font-mono text-[18px] leading-none tracking-[-0.18em] text-[#8fa8c4]\" data-kid=\"1-1-1-1-1\" data-name=\"logo bracket icon\">\n                    <>\n                </span>\n                <span class=\"text-[14px] font-semibold tracking-[0.01em] text-[#f3f6fa]\" data-kid=\"1-1-1-1-2\" data-name=\"application name\">\n                    IntelliCode\n                </span>\n                <span class=\"font-mono text-[10px] text-[#8ba0b7] border border-[#334154] px-1.5 py-0.5 rounded-[3px]\" data-kid=\"1-1-1-1-3\" data-name=\"version tag\">\n                    v0.24\n                </span>\n            </div>\n        </div>\n        <div class=\"flex-1 min-w-0 h-full flex items-center justify-center px-7\" data-kid=\"1-1-2\" data-name=\"search container\">\n            <div class=\"w-full max-w-[560px] h-[30px] border-b-2 border-[#3b82f6] flex items-center gap-2 text-[#7f93a9]\" data-kid=\"1-1-2-1\" data-name=\"search input simulation\">\n                <i class=\"ti ti-search text-[15px] text-[#6f8399]\" data-kid=\"1-1-2-1-1\" data-name=\"search icon\">\n                </i>\n                <span class=\"text-[12px] tracking-[0.01em]\" data-kid=\"1-1-2-1-2\" data-name=\"search placeholder text\">\n                    Search files, symbols, commands...\n                </span>\n                <kbd class=\"ml-auto font-mono text-[10px] text-[#a7b5c6] border border-[#334154] px-1.5 py-0.5 rounded-[3px]\" data-kid=\"1-1-2-1-3\" data-name=\"keyboard shortcut hint\">\n                    Ctrl K\n                </kbd>\n            </div>\n        </div>\n        <div class=\"w-[420px] shrink-0 h-full px-3 flex items-center justify-end gap-0 font-mono text-[10px] text-[#8496aa]\" data-kid=\"1-1-3\" data-name=\"status and user area\">\n            <div class=\"h-6 px-3 flex items-center gap-1.5 border-l border-[#21293a]\" data-kid=\"1-1-3-1\" data-name=\"sync status indicator\">\n                <span class=\"w-1.5 h-1.5 bg-[#10b981] rounded-full\" data-kid=\"1-1-3-1-1\" data-name=\"sync status dot\">\n                </span>\n                <span class=\"text-[#8bd6b5]\" data-kid=\"1-1-3-1-2\" data-name=\"sync status text\">\n                    AST synced\n                </span>\n            </div>\n            <div class=\"h-6 px-3 flex items-center gap-1.5 border-l border-[#21293a] text-[#c1cedc]\" data-kid=\"1-1-3-2\" data-name=\"model selector area\">\n                <i class=\"ti ti-brain text-[14px] text-[#8fa8c4]\" data-kid=\"1-1-3-2-1\" data-name=\"model icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"model name text\">\n                    Claude 3.5 Sonnet\n                </span>\n                <i class=\"ti ti-chevron-down text-[12px] text-[#62758a]\" data-kid=\"1-1-3-2-3\" data-name=\"chevron icon\">\n                </i>\n            </div>\n            <button aria-label=\"Settings\" class=\"h-7 w-8 flex items-center justify-center text-[#8a9bae] hover:text-[#e7edf4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3b82f6]\" data-kid=\"1-1-3-3\" data-name=\"settings button\">\n                <i class=\"ti ti-settings text-[15px]\" data-kid=\"1-1-3-3-1\" data-name=\"settings icon\">\n                </i>\n            </button>\n            <div class=\"ml-1 w-7 h-7 flex items-center justify-center border border-[#3e4c60] bg-[#1a2533] text-[10px] font-semibold text-[#dce7f2] rounded-full\" data-kid=\"1-1-3-4\" data-name=\"user initials avatar\">\n                NK\n            </div>\n        </div>\n    </header>\n    <div class=\"flex-1 min-h-0 flex\" data-kid=\"1-2\" data-name=\"workspace body container\">\n        <aside class=\"w-[48px] shrink-0 bg-[#080b10] border-r border-[#21293a] flex flex-col items-center justify-between py-3\" data-kid=\"1-2-1\" data-name=\"primary sidebar\">\n            <div class=\"flex flex-col items-center gap-2\" data-kid=\"1-2-1-1\" data-name=\"sidebar navigation menu\">\n                <button aria-label=\"Explorer\" class=\"relative w-10 h-10 flex items-center justify-center text-[#d8e4ef] bg-[#121a25] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3b82f6]\" data-kid=\"1-2-1-1-1\" data-name=\"explorer navigation button\">\n                    <span class=\"absolute left-0 top-2 bottom-2 w-[2px] bg-[#3b82f6]\" data-kid=\"1-2-1-1-1-1\" data-name=\"active sidebar indicator\">\n                    </span>\n                    <i class=\"ti ti-folder text-[19px]\" data-kid=\"1-2-1-1-1-2\" data-name=\"folder icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Search\" class=\"w-10 h-10 flex items-center justify-center text-[#65798f] hover:text-[#d8e4ef] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3b82f6]\" data-kid=\"1-2-1-1-2\" data-name=\"search navigation button\">\n                    <i class=\"ti ti-search text-[19px]\" data-kid=\"1-2-1-1-2-1\" data-name=\"search icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Source control\" class=\"w-10 h-10 flex items-center justify-center text-[#65798f] hover:text-[#d8e4ef] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3b82f6]\" data-kid=\"1-2-1-1-3\" data-name=\"source control navigation button\">\n                    <i class=\"ti ti-git-branch text-[19px]\" data-kid=\"1-2-1-1-3-1\" data-name=\"git branch icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Extensions\" class=\"w-10 h-10 flex items-center justify-center text-[#65798f] hover:text-[#d8e4ef] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3b82f6]\" data-kid=\"1-2-1-1-4\" data-name=\"extensions navigation button\">\n                    <i class=\"ti ti-layout-grid text-[19px]\" data-kid=\"1-2-1-1-4-1\" data-name=\"extensions grid icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Codebase database\" class=\"w-10 h-10 flex items-center justify-center text-[#65798f] hover:text-[#d8e4ef] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3b82f6]\" data-kid=\"1-2-1-1-5\" data-name=\"codebase database navigation button\">\n                    <i class=\"ti ti-database text-[19px]\" data-kid=\"1-2-1-1-5-1\" data-name=\"database icon\">\n                    </i>\n                </button>\n            </div>\n            <button aria-label=\"Manage settings\" class=\"w-10 h-10 flex items-center justify-center text-[#65798f] hover:text-[#d8e4ef] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3b82f6]\" data-kid=\"1-2-1-2\" data-name=\"manage settings button\">\n                <i class=\"ti ti-adjustments-horizontal text-[18px]\" data-kid=\"1-2-1-2-1\" data-name=\"settings icon\">\n                </i>\n            </button>\n        </aside>\n        <aside class=\"w-[252px] shrink-0 bg-[#0a0e15] border-r border-[#21293a] flex flex-col min-h-0\" data-kid